{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/real-travel exec vite build --config vite.config.ts --outDir $PWD/dist",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/tours/:slug",
      "destination": "/api/tour-page?slug=:slug"
    },
    {
      "source": "/:lang(ru|en)/tours/:slug",
      "destination": "/api/tour-page?slug=:slug&lang=:lang"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
